{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "landingPage": "/wp-admin/admin.php?page=blablablocks-popup",
    "login": true,
    "features": {
        "networking": true
    },
    "steps": [
        {
            "step": "updateUserMeta",
            "meta": {
                "admin_color": "modern",
                "show_welcome_panel": 0
            },
            "userId": 1
        },
        {
            "step": "setSiteOptions",
            "options": {
                "blogname": "Wordpress BlaBlaBlocks Popup"
            }
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "git:directory",
                "url": "https://github.com/lubusIN/blablablocks-popup.git",
                "ref": "playground",
                "refType": "branch"
            },
            "options": {
                "targetFolderName": "blablablocks-popup"
            }
        }
    ]
}